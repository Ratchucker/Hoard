# Copy to .env.local (git-ignored) for local development, or set in your
# Vercel project's Environment Variables for production.

# PriceCharting API token (40 characters). Get one at https://www.pricecharting.com/api-documentation
# Used server-side only (src/lib/pricing/pricecharting.ts) — never exposed to the browser.
# Without it, the "Scan for current price" feature runs in demo mode with placeholder results.
PRICECHARTING_API_KEY=
